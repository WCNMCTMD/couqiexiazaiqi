<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 网络：任何网络请求的硬前提（此前缺失，导致所有请求"秒失败"） -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 前台服务：后台可靠下载。Android 14+（targetSdk>=34）必须声明细分类型权限 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- 通知：Android 13+ 需运行时申请，用于展示下载进度 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 唤醒锁：息屏后维持下载不被系统挂起 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- 省电策略：申请"忽略电池优化"，避免息屏/后台时前台服务被系统限制，
         导致下载中断。需跳系统页让用户手动设为"无限制/不优化"，无法用普通弹窗申请。 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- 所有文件访问权（MANAGE_EXTERNAL_STORAGE，Android 11+）：
         本 App 为临时自用包（不上架），用它换取 /sdcard 真实文件路径读写能力，
         从而让下载引擎统一使用 java.io.File 落盘（与命令行脚本一致）。
         注意：该权限需跳系统设置页手动授予，无法用普通弹窗申请。 -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- 应用内更新（方案 B）：下载新版 APK 后拉起系统安装器需要此权限（Android 8+）。
         注意：这是"安装未知来源应用"的入口权限，属敏感项，仅用于更新自签名的本 App。 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication"
        tools:targetApi="31">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.MyApplication">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 下载前台服务：Android 14+ 强制要求 foregroundServiceType="dataSync" 及对应权限 -->
        <service
            android:name=".engine.DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- 应用内更新（方案 B）：把下载好的新版 APK 以 content:// 形式安全暴露给系统安装器 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>